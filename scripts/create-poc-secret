#!/usr/bin/env bun

import { chmod, mkdir, readFile, writeFile } from "node:fs/promises";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const projectRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const secretDirectory = resolve(projectRoot, ".secrets");
const secretPath = resolve(secretDirectory, "neo4j-poc.env");

await mkdir(secretDirectory, { recursive: true, mode: 0o700 });

const password = `poc-${crypto.randomUUID().replaceAll("-", "")}`;
const content = [
  `NEO4J_AUTH=neo4j/${password}`,
  "NEO4J_dbms_usage__report_enabled=false",
  "NEO4J_dbms_fleet__manager_enabled=false",
  "NEO4J_server_fleet__discovery_enabled=false",
  "NEO4J_server_bolt_telemetry_enabled=false",
  "",
].join("\n");

try {
  await writeFile(secretPath, content, { encoding: "utf8", flag: "wx", mode: 0o600 });
  console.log(`Created ${secretPath} with mode 0600`);
} catch (error) {
  if (error?.code !== "EEXIST") throw error;
  const existing = await readFile(secretPath, "utf8");
  const auth = existing
    .split("\n")
    .find((line) => line.startsWith("NEO4J_AUTH=neo4j/"));
  if (!auth) throw new Error(`${secretPath} does not contain a valid NEO4J_AUTH`);
  const normalized = [
    auth,
    "NEO4J_dbms_usage__report_enabled=false",
    "NEO4J_dbms_fleet__manager_enabled=false",
    "NEO4J_server_fleet__discovery_enabled=false",
    "NEO4J_server_bolt_telemetry_enabled=false",
    "",
  ].join("\n");
  await writeFile(secretPath, normalized, { encoding: "utf8", mode: 0o600 });
  await chmod(secretPath, 0o600);
  console.log(`Normalized existing ${secretPath} and enforced mode 0600`);
}
